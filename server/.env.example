PORT=3000
NODE_ENV=development
SUPABASE_URL=https://replace-with-project-reference.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_server_only_service_role_key
CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
GEMINI_API_KEY=replace_with_server_only_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Optional legacy/shared OpenAI key. Permanent users continue to use stored BYOK credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Example development origins only. Set the deployed environment explicitly.
# Production canonical origin: https://www.chanson-a-repondre-uno.scot
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080
REQUEST_TIMEOUT_MS=60000
MAX_REQUEST_BODY_BYTES=10485760
